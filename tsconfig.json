{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    "src/app/(main)/_archive/**",
    "src/app/(main)/_archive_settings/**",
    "src/app/_archive_factory/**",
    "src/app/_archive_portal/**",
    "src/lib/actions/_legacy_pages/**",
    "src/components/_legacy_pages/**",
    "src/components/deals/_legacy_pages/**",
    "src/app/(main)/deals/[id]/_legacy_pages/**"
  ]
}
